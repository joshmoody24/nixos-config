// Seeded from GNOME's monitors.xml; nwg-displays overwrites this wholesale,
// header comments included.
//
// DisplayPort connector numbers get reshuffled across reboots: the HDMI has
// shown up as both DP-11 and DP-9, the second LG as both DP-12 and DP-10. So
// match on make/model/serial where that is unique. It is not unique for the two
// LGs, which report identical strings, so niri leaves the second one unnamed and
// it has to go by connector; both of its observed names get a block, since only
// one can be present at a time. This is why GNOME stored five profiles.

// Portrait, far left.
output "DP-12" {
    mode "1920x1080@74.973"
    scale 1
    transform "270"
    position x=0 y=225
}
output "DP-10" {
    mode "1920x1080@74.973"
    scale 1
    transform "270"
    position x=0 y=225
}

// Landscape, above the laptop.
output "DP-4" {
    mode "1920x1080@74.973"
    scale 1
    transform "normal"
    position x=1080 y=0
}

output "BOE 0x0BC9 Unknown" {
    mode "2560x1600@165.000"
    scale 1.5
    transform "normal"
    position x=1080 y=1080
}

output "Audio Processing Technology  Ltd HDMI Unknown" {
    mode "1920x1080@60.000"
    scale 1
    transform "normal"
    position x=2787 y=1080
}
