// Seeded from GNOME's monitors.xml; nwg-displays overwrites this wholesale,
// header comments included. DP-4 and DP-12 are two separate LG FHDs that
// report the same serial.

output "DP-12" {
    mode "1920x1080@74.973"
    scale 1
    transform "270"
    position x=0 y=225
}

output "DP-4" {
    mode "1920x1080@74.973"
    scale 1
    transform "normal"
    position x=1080 y=0
}

output "eDP-1" {
    mode "2560x1600@165.000"
    scale 1.5
    transform "normal"
    position x=1080 y=1080
}

output "DP-11" {
    mode "1920x1080@60.000"
    scale 1
    transform "normal"
    position x=2787 y=1080
}
