#!/usr/bin/env bash
# llama.cpp router for pi. In pi: /llama loads a model, /model selects it.
#
#   llm-serve            # one slot, max context
#   llm-serve parallel   # 4 slots: best-of-N sampling, or concurrent sessions
#
# Overridable: MODELS_DIR PORT NP PER_SLOT CTX KV EFFORT RESERVE_GIB KV_KIB_PER_TOKEN
set -euo pipefail

MODELS_DIR="${MODELS_DIR:-$HOME/models}"
PROFILE="${1:-solo}"
PORT="${PORT:-9931}"

[ -d "$MODELS_DIR" ] || { echo "no model directory: $MODELS_DIR" >&2; exit 1; }

# The 7900 XT drives the display, so overcommitting VRAM takes the screen down.
RESERVE_GIB="${RESERVE_GIB:-3}"

# Card numbering is not stable; pick whichever reports VRAM.
DRM_DEV="${DRM_DEV:-$(for c in /sys/class/drm/card[0-9]*/device; do
  [ -r "$c/mem_info_vram_total" ] && [ "$(cat "$c/mem_info_vram_total")" -gt 0 ] && echo "$c" && break
done)}"
[ -n "$DRM_DEV" ] || { echo "no GPU with readable VRAM found" >&2; exit 1; }

# Qwen3.8-27B pays KV on only 16 of its 64 layers; the rest are linear-attention
# with constant-size state. A fully-attentive model costs ~4x this, so raise it
# or pass CTX directly.
KV_KIB_PER_TOKEN="${KV_KIB_PER_TOKEN:-32}"

vram_gib() { awk '{printf "%.2f", $1/1073741824}' "$DRM_DEV/$1"; }

# One context size covers whichever model the router loads, so budget for the largest.
biggest=$(find "$MODELS_DIR" -name '*.gguf' -printf '%s\n' 2>/dev/null | sort -rn | head -1)
[ -n "$biggest" ] || { echo "no .gguf files under $MODELS_DIR" >&2; exit 1; }
weights_gib=$(awk -v b="$biggest" 'BEGIN{printf "%.2f", b/1073741824}')

budget_ctx() {
  awk -v t="$(vram_gib mem_info_vram_total)" -v r="$RESERVE_GIB" -v w="$weights_gib" \
      -v b="$2" -v kib="$KV_KIB_PER_TOKEN" -v n="$1" 'BEGIN{
    avail = t - r - w - b
    if (avail <= 0) { print 0; exit }
    print int((avail * 1048576 / kib) / n / 1024) * 1024
  }'
}

case "$PROFILE" in
  solo)
    NP="${NP:-1}"
    CTX="${CTX:-$(budget_ctx "$NP" 0.8)}"
    ;;
  parallel)
    # 4 slots is the measured knee: 51% scaling efficiency at 4, 30% marginal at 8.
    # Splitting one task across slots loses outright.
    NP="${NP:-4}"
    CTX="${CTX:-$(( ${PER_SLOT:-16384} * NP ))}"
    ;;
  *) echo "unknown profile: $PROFILE (want solo or parallel)" >&2; exit 1 ;;
esac

[ "$CTX" -gt 0 ] || { echo "no VRAM headroom for $weights_gib GiB of weights plus a ${RESERVE_GIB} GiB reserve" >&2; exit 1; }

echo "VRAM $(vram_gib mem_info_vram_used)/$(vram_gib mem_info_vram_total) GiB in use, reserving ${RESERVE_GIB} GiB" >&2
echo "router on :$PORT  ctx=$CTX slots=$NP  -> in pi: /llama to load, /model to select" >&2

# Passing -m would start single-model mode instead of the router.
# effort defaults to xhigh, which truncates before answering; low gains nothing.
# Hybrid-attention models need the checkpoint flags to rewind a cached prompt.
exec llama-server \
  --models-dir "$MODELS_DIR" \
  --no-models-autoload \
  --host 127.0.0.1 --port "$PORT" \
  --device "${DEVICE:-Vulkan0}" \
  -ngl 99 --jinja -fa on \
  --cache-type-k "${KV:-q8_0}" --cache-type-v "${KV:-q8_0}" \
  --cache-ram "${CACHE_RAM:-4096}" \
  --ctx-checkpoints 32 --checkpoint-min-step 0 \
  -c "$CTX" -np "$NP" \
  --temp 1.0 --top-p 0.95 --top-k 20 --min-p 0.0 \
  --chat-template-kwargs "{\"reasoning_effort\":\"${EFFORT:-medium}\"}" \
  "${@:2}"
