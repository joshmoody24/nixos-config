layout {
    // A custom layout replaces zellij's built-in chrome, so the bars are explicit.
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="Vim" focus=true {
        // Quitting nvim would otherwise close the pane and take the tab with it.
        pane command="nvim" close_on_exit=false
    }
    tab name="App" {
        pane
    }
    tab name="Terminal" {
        pane
    }
    tab name="Agent" {
        pane
    }
}
